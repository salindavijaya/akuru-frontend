# ─────────────────────────────────────────────────────────────
# Akuru Frontend — Environment Variables
# Copy to .env.local for local dev (never commit .env.local)
# ─────────────────────────────────────────────────────────────

# Backend API base URL
# Dev:        leave empty — Vite proxy handles /api/* → localhost:3000
# Production: set to your Cloud Run service URL (no trailing slash)
VITE_API_URL=https://sinhala-ocr-api-xxxxxxxxxx-uc.a.run.app
